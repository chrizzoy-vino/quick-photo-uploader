DATABASE_URL="file:./data/db.sqlite"
STORAGE_ROOT="./data/albums"
# Access secret for the admin area (/admin) - a long, random value, e.g. generated via
# `openssl rand -hex 32`. Without a value set, the admin area stays locked.
ADMIN_SECRET=""
# Directory for the operator-provided legal pages (impressum.md, datenschutz.md). Optional -
# if a file is missing, its page shows a placeholder instead of failing. See ADR-0010.
CONTENT_ROOT="./data/content"
